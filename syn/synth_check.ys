# synth_check.ys — technology-independent elaboration and flip-flop count.
# Works with any Yosys version. For real sky130 cell area use
# syn/area_sky130.sh instead.

read_verilog -sv src/tp_pkg.sv
read_verilog -sv src/sync/sync_timebase.sv
read_verilog -sv src/sync/sync_capture.sv
read_verilog -sv src/sync/sync_event_fifo.sv
read_verilog -sv src/sync/sync_compare.sv
read_verilog -sv src/sync/sync_unit.sv
read_verilog -sv src/uart/tp_uart_rx.sv
read_verilog -sv src/uart/tp_uart_tx.sv
read_verilog -sv src/uart/tp_host_uart.sv
read_verilog -sv src/tp_sync_soc.sv
read_verilog -sv src/tt_um_normansrule_tiqora_serial.sv
hierarchy -check -top tt_um_normansrule_tiqora_serial
synth -top tt_um_normansrule_tiqora_serial -flatten -noabc
select -assert-none t:$dlatch t:$_DLATCH_*
tee -o syn/stat.txt stat
