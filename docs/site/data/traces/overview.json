 "checks": [
  {
   "ok": true,
   "text": "ping 0x03 answers 0x5A, version 0x01"
  },
  {
   "ok": true,
   "text": "write CFG = 1 (capture channel 0, rising) answers ACK 0x06"
  },
  {
   "ok": true,
   "text": "read TIME returns the timebase, least significant byte first"
  },
  {
   "ok": true,
   "text": "write CMP0 = TIME + 60000 answers ACK"
  },
  {
   "ok": true,
   "text": "TRIG0 (uo_out[0]) rises on exactly the deadline tick"
  },
  {
   "ok": true,
   "text": "TRIG0 pulse is 8 ticks wide at the pin"
  },
  {
   "ok": true,
   "text": "edge on CAP0: EVT high, one EVTP pulse, EVQ = 1, EVCH = 0, EVED = 1"
  },
  {
   "ok": true,
   "text": "read EVENT pops it: channel 0, rising; EVT goes low"
  },
  {
   "ok": true,
   "text": "unknown command 0x7E answers NAK 0x15"
  },
  {
   "ok": true,
   "text": "truncated write: no reply; the port waits for data bytes"
  },
  {
   "ok": true,
   "text": "a ping sent now is taken as a data byte: still no reply"
  },
  {
   "ok": true,
   "text": "after reset the port answers a ping again"
  },
  {
   "ok": true,
   "text": "read STAT after reset: no overflow, queue empty"
  }
 ],
