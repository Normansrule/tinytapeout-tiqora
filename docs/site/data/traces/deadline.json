 "captions": [
  {
   "at": 68387,
   "blocks": [
    "tp_uart_rx",
    "sync_compare"
   ],
   "text": "Host sends 01 04 8A B2 01 00: write CMP0 = 0x0001B28A."
  },
  {
   "at": 94213,
   "blocks": [
    "tp_host_uart",
    "sync_unit"
   ],
   "text": "H_DO: one clock on the register port, offset 4 (CMP0)."
  },
  {
   "at": 94214,
   "blocks": [
    "sync_compare"
   ],
   "text": "armed[0] goes high on the H_DO clock: channel 0 now waits for tick 111242 (the TIME read + 60000)."
  },
  {
   "at": 94215,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers 06."
  },
  {
   "at": 111238,
   "blocks": [
    "sync_compare"
   ],
   "text": "Tick 111242: TRIG0 (uo_out[0]) rises on exactly the deadline tick. No host is involved; the ACK went out long ago."
  },
  {
   "at": 111246,
   "blocks": [
    "sync_compare"
   ],
   "text": "TRIG0 falls 8 ticks later: the default pulse width of 8. armed[0] cleared when it fired, so it fires once."
  }
 ],
