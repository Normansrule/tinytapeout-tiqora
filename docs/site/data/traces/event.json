 "captions": [
  {
   "at": 111260,
   "blocks": [
    "sync_capture"
   ],
   "text": "CAP0 (ui_in[0]) rises. Capture is enabled for channel 0, rising edges (the CFG write in the first tour)."
  },
  {
   "at": 111263,
   "blocks": [
    "sync_capture",
    "sync_unit"
   ],
   "text": "3 clocks later the edge is through the two-flop synchronizer and the edge detector: EVTP pulses for one clock and EVT goes high."
  },
  {
   "at": 111263,
   "blocks": [
    "sync_event_fifo",
    "tt_um_normansrule_tiqora_serial"
   ],
   "text": "The board can see the event without asking: EVQ = 1 (one queued), EVCH = 0, EVED = 1 (rising) on the uio pins."
  },
  {
   "at": 111266,
   "blocks": [
    "tp_uart_rx",
    "sync_event_fifo"
   ],
   "text": "Host sends 02 01: read EVENT."
  },
  {
   "at": 119732,
   "blocks": [
    "tp_host_uart",
    "sync_unit"
   ],
   "text": "H_DO: one clock on the register port, offset 1 (EVENT)."
  },
  {
   "at": 119733,
   "blocks": [
    "sync_event_fifo"
   ],
   "text": "Reading EVENT pops the queue on the H_DO clock: EVQ and EVT drop. The word is source 0 (pin), channel 0, rising, timestamp 111266."
  },
  {
   "at": 119734,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers A2 B2 01 08, least significant byte first: 0x0801B2A2."
  }
 ],
