 "captions": [
  {
   "at": 136881,
   "blocks": [
    "tp_uart_rx",
    "tp_host_uart"
   ],
   "text": "Host sends 7E: unknown 0x7E."
  },
  {
   "at": 141008,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers 15, NAK: not a command it knows. The port is back in H_CMD and nothing else changed."
  },
  {
   "at": 145344,
   "blocks": [
    "tp_host_uart"
   ],
   "text": "Host sends 01 07 20: a write cut off after its address and one data byte. The port is in H_DATA with 3 bytes to go, and it has no timeout."
  },
  {
   "at": 175723,
   "blocks": [
    "tp_host_uart"
   ],
   "text": "The host gives up and pings (03). The port takes it as the second data byte: no reply. A host that loses sync sees silence, not an error."
  },
  {
   "at": 197422,
   "blocks": [
    "tt_um_normansrule_tiqora_serial",
    "tp_host_uart"
   ],
   "text": "Reset (rst_n low) is the only thing that clears it. The rest of the chip resets too: timebase, queue and comparators."
  },
  {
   "at": 197442,
   "blocks": [
    "tp_uart_rx",
    "tp_host_uart"
   ],
   "text": "Host sends 03: ping."
  },
  {
   "at": 201570,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "After reset the ping answers 5A 01 again."
  }
 ],
