 "captions": [
  {
   "at": 16,
   "blocks": [
    "tp_uart_rx",
    "tp_host_uart"
   ],
   "text": "Host sends 03: ping. One byte: a start bit (low), eight data bits least significant first, a stop bit (high), 434 clocks each."
  },
  {
   "at": 4143,
   "blocks": [
    "tp_host_uart"
   ],
   "text": "H_SEND with 2 bytes to go: 0x5A (the magic) and 0x01 (the version). The reply is shifted out of the same 32-bit register that collects write data."
  },
  {
   "at": 4144,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers 5A 01."
  },
  {
   "at": 12609,
   "blocks": [
    "tp_uart_rx",
    "tp_host_uart"
   ],
   "text": "Host sends 01 03 01 00 00 00: write CFG = 0x00000001."
  },
  {
   "at": 21075,
   "blocks": [
    "tp_host_uart"
   ],
   "text": "H_DATA: four data bytes to collect, least significant first; each one shifts in at the top of the register."
  },
  {
   "at": 38435,
   "blocks": [
    "tp_host_uart",
    "sync_unit"
   ],
   "text": "H_DO: one clock on the register port, offset 3 (CFG)."
  },
  {
   "at": 38437,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers 06."
  }
 ],
