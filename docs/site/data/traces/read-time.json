   "text": "Host sends 02 00: read TIME."
  },
  {
   "at": 51238,
   "blocks": [
    "tp_host_uart",
    "sync_unit"
   ],
   "text": "H_DO: one clock on the register port, offset 0 (TIME). The timebase reads 51242 at this clock, and that exact value is what goes back."
  },
  {
   "at": 51240,
   "blocks": [
    "tp_uart_tx",
    "tp_host_uart"
   ],
   "text": "The chip answers 2A C8 00 00, least significant byte first: 0x0000C82A."
  },
  {
   "at": 64263,
   "blocks": [
    "sync_timebase"
   ],
   "text": "Four bytes have gone out; the host reassembles them, lowest first. By the time the last stop bit ends, 17365 clocks after the read, the timebase has moved on: the answer is a timestamp of the read, not of the moment it arrives."
  }
 ],
